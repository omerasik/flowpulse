{
  "name": "flowpulse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings .",
    "demo": "node --env-file-if-exists=.env scripts/demo.mjs",
    "worker": "node --env-file-if-exists=.env scripts/worker.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@trigger.dev/sdk": "4.8.5",
    "next": "16.4.6",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "oxlint": "1.94.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
